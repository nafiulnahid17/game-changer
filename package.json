{
  "name": "game-changer-atherious",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Game Changer — Cloudflare-first AI workspace",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "db:local": "wrangler d1 migrations apply game-changer-db --local",
    "db:remote": "wrangler d1 migrations apply game-changer-db --remote",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js && node --check src/auth.js && node --check src/ai.js && node --check public/app.js && npm test"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
